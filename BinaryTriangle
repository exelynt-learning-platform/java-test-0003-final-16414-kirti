public class BinaryTriangle {

    private static final int ROWS = 6; 

    public static void main(String[] args) {

        for (int i = 1; i <= ROWS; i++) {

            int num;


            if (i % 2 == 0) {
                num = 0;
            } else {
                num = 1;
            }

            for (int j = 1; j <= i; j++) {
                System.out.print(num + " ");

            
                if (num == 0) {
                    num = 1;
                } else {
                    num = 0;
                }
            }

            System.out.println();
        }
    }
}
